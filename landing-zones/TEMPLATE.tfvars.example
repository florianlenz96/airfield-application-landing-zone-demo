# Request a landing zone: copy this file to landing-zones/<your-app>.tfvars.
# The file name becomes the landing zone's name. Also add your subscription to
# platform/terraform.tfvars (workloads + subscriptions). One pull request for both.

subscription_id   = "<your-subscription-id>"
address_space     = ["10.100.XX.0/24"] # next free /24 from the IP plan in README.md
github_repository = "<owner>/<repo>"

tags = {
  owner         = "<team>"
  "cost-center" = "<cost-center>"
  env           = "prod"
}
